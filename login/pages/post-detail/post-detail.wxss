/* pages/post-detail/post-detail.wxss */
page {
    background-color: #f5f5f5;
    padding-bottom: 120rpx;
}

/* 头部 */
.header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 88rpx;
    background: #ffffff;
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    z-index: 1000;
    border-bottom: 2rpx solid #f0f0f0;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.back-btn,
.more-btn {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cuIcon-back,
.cuIcon-more {
    font-size: 36rpx;
    color: #333;
}

.header-title-container {
    flex: 1;
    text-align: center;
}

.header-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #333;
}

/* 主要内容区域 */
.content-scroll {
    height: 100vh;
    padding-top: 88rpx;
    padding-bottom: 140rpx;
}

/* 作者信息 */
.author-section {
    background: #fff;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.author-info {
    display: flex;
    align-items: center;
}

.author-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.author-details {
    flex: 1;
}

.author-nickname {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 10rpx;
}

.author-meta {
    display: flex;
    align-items: center;
    font-size: 24rpx;
    color: #666;
}

.cuIcon-location {
    font-size: 24rpx;
    margin-right: 8rpx;
    color: #999;
}

.location-text {
    margin-right: 30rpx;
}

.follow-btn {
    background: #07c160;
    color: #fff;
    border-radius: 40rpx;
    padding: 8rpx 30rpx;
    font-size: 24rpx;
    line-height: 1.4;
    border: none;
}

.follow-btn.following {
    background: #f0f0f0;
    color: #666;
}

/* 天气卡片 */
.weather-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    margin: 30rpx;
    border-radius: 20rpx;
    padding: 30rpx;
    color: #fff;
    box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.2);
}

.weather-header {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
}

.cuIcon-info {
    font-size: 32rpx;
    margin-right: 15rpx;
}

.weather-title {
    font-size: 32rpx;
    font-weight: 600;
}

.weather-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
}

.weather-item {
    display: flex;
    align-items: center;
}

.cuIcon-cloud,
.cuIcon-wind,
.cuIcon-temperature,
.cuIcon-humidity {
    font-size: 36rpx;
    margin-right: 15rpx;
    opacity: 0.9;
}

.weather-item-content {
    display: flex;
    flex-direction: column;
}

.weather-label {
    font-size: 22rpx;
    opacity: 0.8;
}

.weather-value {
    font-size: 28rpx;
    font-weight: 500;
    margin-top: 5rpx;
}

/* 帖子内容 */
.post-content-section {
    background: #fff;
    margin: 30rpx;
    padding: 40rpx;
    border-radius: 20rpx;
    box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.05);
}

.post-text {
    font-size: 32rpx;
    line-height: 1.6;
    color: #333;
    margin-bottom: 30rpx;
}

.post-images-swiper {
    height: 500rpx;
    border-radius: 15rpx;
    overflow: hidden;
    margin-bottom: 30rpx;
}

.post-image {
    width: 100%;
    height: 100%;
}

.post-meta {
    display: flex;
    justify-content: space-between;
    padding-top: 30rpx;
    border-top: 1rpx solid #f0f0f0;
    color: #999;
    font-size: 24rpx;
}

.post-meta-item {
    display: flex;
    align-items: center;
}

.cuIcon-time,
.cuIcon-eye {
    font-size: 24rpx;
    margin-right: 10rpx;
}

/* 互动功能区 */
.interaction-section {
    background: #fff;
    margin: 30rpx;
    padding: 20rpx 40rpx;
    border-radius: 20rpx;
}

.interaction-buttons {
    display: flex;
    justify-content: space-around;
    align-items: center;
}

.interaction-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20rpx;
    border-radius: 15rpx;
    transition: all 0.3s;
}

.interaction-btn:active {
    background: #f5f5f5;
}

.interaction-btn.liked .cuIcon-like,
.interaction-btn.favorited .cuIcon-favor {
    transform: scale(1.2);
}

.cuIcon-like,
.cuIcon-favor,
.cuIcon-share,
.cuIcon-moneybag {
    font-size: 44rpx;
    margin-bottom: 10rpx;
    color: #666;
}

.text-red {
    color: #e54d42 !important;
}

.text-yellow {
    color: #fbbd08 !important;
}

.btn-text {
    font-size: 24rpx;
    color: #666;
}

/* 评论区域 */
.comments-section {
    background: #fff;
    margin: 30rpx;
    padding: 40rpx;
    border-radius: 20rpx;
    margin-bottom: 140rpx;
}

.comments-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.comments-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
}

.sort-comments {
    display: flex;
    align-items: center;
    font-size: 26rpx;
    color: #666;
}

.cuIcon-unfold {
    font-size: 26rpx;
    margin-left: 10rpx;
}

/* 评论列表 */
.comment-item {
    display: flex;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f8f8f8;
}

.comment-item:last-child {
    border-bottom: none;
}

.comment-avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    flex-shrink: 0;
}

.comment-content {
    flex: 1;
}

.comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15rpx;
}

.comment-nickname {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
}

.comment-time {
    font-size: 22rpx;
    color: #999;
}

.reply-to {
    background: #f8f8f8;
    padding: 10rpx 15rpx;
    border-radius: 8rpx;
    margin-bottom: 15rpx;
}

.reply-text {
    font-size: 24rpx;
    color: #666;
}

.comment-text {
    font-size: 28rpx;
    line-height: 1.5;
    color: #333;
    margin-bottom: 20rpx;
}

.comment-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.comment-actions {
    display: flex;
    align-items: center;
}

.comment-like,
.comment-reply {
    display: flex;
    align-items: center;
    margin-right: 40rpx;
    font-size: 24rpx;
    color: #999;
}

.comment-like.liked {
    color: #e54d42;
}

.cuIcon-likefill,
.cuIcon-message {
    font-size: 24rpx;
    margin-right: 8rpx;
}

.like-count {
    margin-left: 5rpx;
}

/* 子评论 */
.sub-comments {
    background: #f8f8f8;
    border-radius: 10rpx;
    padding: 20rpx;
    margin-top: 20rpx;
}

.sub-comment-item {
    padding: 15rpx 0;
    border-bottom: 1rpx solid #eee;
}

.sub-comment-item:last-child {
    border-bottom: none;
}

.sub-comment-content {
    font-size: 26rpx;
    line-height: 1.4;
    color: #333;
    margin-bottom: 10rpx;
}

.sub-nickname {
    font-weight: 500;
    color: #07c160;
}

.reply-nickname {
    color: #666;
}

.sub-comment-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 22rpx;
    color: #999;
}

.sub-comment-like {
    display: flex;
    align-items: center;
}

.view-more-subcomments {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20rpx;
    color: #07c160;
    font-size: 24rpx;
}

.cuIcon-unfold {
    font-size: 24rpx;
    margin-left: 10rpx;
}

/* 加载更多评论 */
.load-more-comments {
    padding: 40rpx 0;
    text-align: center;
}

.load-more-btn {
    display: inline-flex;
    align-items: center;
    padding: 20rpx 40rpx;
    background: #f8f8f8;
    border-radius: 40rpx;
    font-size: 26rpx;
    color: #666;
}

.cuIcon-refresh {
    font-size: 26rpx;
    margin-left: 10rpx;
}

/* 暂无评论 */
.no-comments {
    text-align: center;
    padding: 80rpx 0;
}

.no-comments-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
    opacity: 0.5;
}

.no-comments-text {
    font-size: 28rpx;
    color: #999;
}

/* 底部评论输入框 */
.comment-input-container {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 20rpx 30rpx;
    border-top: 1rpx solid #f0f0f0;
    transition: all 0.3s ease;
    z-index: 1000;
}

.comment-input-container.input-active {
    padding-bottom: env(safe-area-inset-bottom);
}

.comment-input-wrapper {
    display: flex;
    align-items: flex-end;
    background: #f8f8f8;
    border-radius: 40rpx;
    padding: 20rpx;
    position: relative;
}

.reply-hint {
    position: absolute;
    top: -50rpx;
    left: 0;
    right: 0;
    background: #07c160;
    color: #fff;
    padding: 10rpx 20rpx;
    border-radius: 10rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 24rpx;
}

.cancel-reply {
    font-size: 32rpx;
    padding: 0 10rpx;
}

.comment-textarea {
    flex: 1;
    background: transparent;
    font-size: 28rpx;
    min-height: 40rpx;
    max-height: 200rpx;
    padding: 10rpx 20rpx;
}

.comment-submit-btn {
    background: #e0e0e0;
    color: #999;
    border-radius: 40rpx;
    padding: 15rpx 40rpx;
    font-size: 28rpx;
    line-height: 1.4;
    border: none;
    margin-left: 20rpx;
    transition: all 0.3s;
}

.comment-submit-btn.active {
    background: #07c160;
    color: #fff;
}

/* 更多操作菜单 */
.action-sheet {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2000;
}

.action-sheet-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
}

.action-sheet-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 30rpx 30rpx 0 0;
    padding: 30rpx;
}

.action-sheet-list {
    display: flex;
    flex-direction: column;
}

.action-item {
    display: flex;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
    font-size: 32rpx;
    color: #333;
}

.action-item:last-child {
    border-bottom: none;
    justify-content: center;
    color: #666;
}

.cuIcon-warn,
.cuIcon-edit,
.cuIcon-delete,
.cuIcon-link,
.cuIcon-close {
    font-size: 32rpx;
    margin-right: 20rpx;
}

.cuIcon-warn {
    color: #fbbd08;
}

.cuIcon-edit {
    color: #07c160;
}

.cuIcon-delete {
    color: #e54d42;
}

.cuIcon-link {
    color: #0081ff;
}

.cuIcon-close {
    color: #999;
}

/* pages/post-detail/post-detail.wxss */

/* iOS风格侧滑返回指示器 */
.swipe-indicator {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 88rpx;
    z-index: 1001;
    pointer-events: none;
    display: flex;
    align-items: center;
    padding-left: 20rpx;
    opacity: 0;
    animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

.swipe-line {
    width: 60rpx;
    height: 6rpx;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 3rpx;
}

/* 增强的头部导航栏 */
.header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 88rpx;
    background: #ffffff;
    backdrop-filter: blur(20rpx);
    -webkit-backdrop-filter: blur(20rpx);
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    z-index: 1000;
    border-bottom: 2rpx solid #f0f0f0;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 改进的返回按钮 */
.back-btn {
    display: flex;
    align-items: center;
    padding: 16rpx 24rpx 16rpx 16rpx;
    background: rgba(0, 0, 0, 0.05);
    border-radius: 40rpx;
    transition: all 0.3s;
    margin-right: 20rpx;
    min-width: 120rpx;
}

.back-btn:active {
    background: rgba(0, 0, 0, 0.1);
    transform: scale(0.95);
}

.cuIcon-back {
    font-size: 36rpx;
    color: #333;
    font-weight: 600;
    margin-right: 8rpx;
}

.back-text {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.header-title {
    flex: 1;
    text-align: center;
    font-size: 34rpx;
    font-weight: 600;
    color: #333;
}

.more-btn {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: all 0.3s;
}

.more-btn:active {
    background: rgba(0, 0, 0, 0.1);
}

.cuIcon-more {
    font-size: 40rpx;
    color: #333;
    font-weight: bold;
}

/* 右下角悬浮返回按钮 */
.floating-back-btn {
    position: fixed;
    bottom: 200rpx;
    /* 放在评论输入框上方 */
    right: 30rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 999;
    opacity: 0;
    transform: translateY(20rpx) scale(0.9);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
}

.floating-back-btn.show {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
}

.floating-back-btn-inner {
    width: 100rpx;
    height: 100rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.4);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.floating-back-btn-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.3s;
}

.floating-back-btn:active .floating-back-btn-inner::before {
    opacity: 1;
}

.floating-btn-text {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #666;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.9);
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(10rpx);
    -webkit-backdrop-filter: blur(10rpx);
}

.cuIcon-back {
    font-size: 48rpx;
    color: #fff;
    font-weight: bold;
}

/* 悬停效果 */
.hover-effect .floating-back-btn-inner {
    transform: scale(1.1);
    box-shadow: 0 15rpx 40rpx rgba(102, 126, 234, 0.5);
}

/* 键盘弹起时调整按钮位置 */
.comment-input-container.input-active+.floating-back-btn {
    bottom: 320rpx;
    /* 键盘弹出时提高位置 */
}

.floating-back-btn:active {
    background: rgba(255, 255, 255, 0.85);
    transform: scale(0.92);
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.floating-back-btn .cuIcon-back {
    font-size: 44rpx;
    color: #333;
}

/* 主要内容区域 */
.content-scroll {
    height: 100vh;
    padding-top: 88rpx;
    padding-bottom: 140rpx;
}

/* 添加页面切换动画效果 */
.post-detail-container {
    animation: pageIn 0.3s ease;
}

@keyframes pageIn {
    from {
        opacity: 0;
        transform: translateX(20rpx);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* 安全区域适配（iPhone X及以上） */
@media only screen and (min-height: 812px) {
    .floating-back-btn {
        bottom: 240rpx;
        /* 在全面屏手机上稍微提高 */
    }

    .comment-input-container.input-active+.floating-back-btn {
        bottom: 360rpx;
    }
}