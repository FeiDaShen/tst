/* pages/home.wxss */
/* 页面容器 */
.home-container {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background-color: #f8f8f8;
}

/* 顶部跑马灯 */
.marquee-container {
    height: 80rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    flex-shrink: 0;
    z-index: 10;
}

.marquee-swiper {
    height: 100%;
    width: 100%;
}

.marquee-item {
    display: flex;
    align-items: center;
    height: 100%;
}

.marquee-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 15rpx;
}

/* 调整各图标尺寸和颜色 */
.marquee-icon {
    font-size: 36rpx;
    line-height: 36rpx;
    color: #fff;
    margin-right: 15rpx;
}

.location-icon {
    font-size: 28rpx;
    line-height: 28rpx;
    color: #7f8c8d;
    margin: 0 8rpx;
}

.vote-icon {
    font-size: 34rpx;
    line-height: 34rpx;
}

.vote-down {
    color: #ff4757;
}

.vote-up {
    color: #2ed573;
}

.reward-icon {
    font-size: 32rpx;
    line-height: 32rpx;
    margin-right: 12rpx;
}

.sort-icon {
    font-size: 48rpx;
    line-height: 48rpx;
    color: #fff;
}

.sort-option-icon {
    font-size: 36rpx;
    line-height: 36rpx;
    margin-right: 20rpx;
    color: #333;
}

.sort-check {
    font-size: 28rpx;
    line-height: 28rpx;
    color: #1989fa;
}

.marquee-text {
    font-size: 28rpx;
    color: white;
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 帖子列表 */
.post-list {
    flex: 1;
    overflow: hidden;
    padding: 20rpx;
    -webkit-overflow-scrolling: touch;
}

/* 加载更多容器 - 固定高度防止跳动 */
.load-more-container {
    min-height: 120rpx;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20rpx 0;
    transition: all 0.3s ease;
}

/* 加载中样式 */
.loading-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30rpx 0;
}

.loading-content {
    display: flex;
    align-items: center;
    justify-content: center;
}

.loading-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 15rpx;
    animation: rotate 1s linear infinite;
}

@keyframes rotate {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

.loading-text {
    font-size: 28rpx;
    color: #999;
}

/* 没有更多数据样式 */
.no-more-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40rpx 0;
}

.no-more-content {
    display: flex;
    align-items: center;
    justify-content: center;
}

.no-more-text {
    font-size: 26rpx;
    color: #ccc;
    text-align: center;
}

/* 空数据状态 */
.empty-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    width: 100%;
}

.empty-icon {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 40rpx;
    opacity: 0.5;
}

.empty-text {
    font-size: 30rpx;
    color: #999;
    text-align: center;
}

/* 初始加载骨架屏 */
.initial-loading {
    width: 100%;
}

.skeleton-item {
    display: flex;
    background-color: white;
    border-radius: 16rpx;
    margin-bottom: 20rpx;
    padding: 30rpx 20rpx;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-pulse {

    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.5;
    }
}


.skeleton-left,
.skeleton-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100rpx;
    flex-shrink: 0;
}

.skeleton-circle {
    width: 48rpx;
    height: 48rpx;
    margin-bottom: 10rpx;
    background-color: #f0f0f0;
    border-radius: 50%;
}

.skeleton-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
}

.skeleton-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    background-color: #f0f0f0;
    flex-shrink: 0;
}

.skeleton-user {
    flex: 1;
    overflow: hidden;
}

.skeleton-body {
    margin-bottom: 25rpx;
}

.skeleton-line {
    height: 30rpx;
    background-color: #f0f0f0;
    border-radius: 6rpx;
    margin-bottom: 15rpx;
}

.skeleton-line.long {
    width: 90%;
}

.skeleton-line.medium {
    width: 60%;
}

.skeleton-line.short {
    width: 40%;
}

.skeleton-line.small {
    width: 30rpx;
    height: 20rpx;
    margin: 0 auto;
}

.skeleton-center {
    flex: 1;
    padding: 0 20rpx;
}

/* 帖子项优化 - 重新布局：取消左中右结构 */
.post-item {
    background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
    border-radius: 20rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
    padding: 32rpx 16rpx;
    position: relative;
    transform: translateZ(0);
    will-change: transform;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1rpx solid rgba(0, 0, 0, 0.02);
    overflow: hidden;
}

.post-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4rpx;
    background: linear-gradient(90deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.post-item:active {
    transform: scale(0.98) translateY(2rpx);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12), 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

.post-item:active::before {
    opacity: 1;
}

/* 投票按钮区域 - 在打赏区域中的样式 */
.vote-left,
.vote-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    padding: 12rpx 8rpx;
    border-radius: 12rpx;
    transition: all 0.3s ease;
    position: relative;
    max-width: 120rpx;
}

.vote-left {
    background: linear-gradient(135deg, rgba(255, 107, 107, 0.1) 0%, rgba(255, 77, 77, 0.05) 100%);
    border: 1rpx solid rgba(255, 107, 107, 0.2);
}

.vote-right {
    background: linear-gradient(135deg, rgba(7, 193, 96, 0.1) 0%, rgba(7, 193, 96, 0.05) 100%);
    border: 1rpx solid rgba(7, 193, 96, 0.2);
}

.vote-left:active,
.vote-right:active {
    transform: scale(0.95);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.vote-icon {
    width: 40rpx;
    height: 40rpx;
    margin-bottom: 6rpx;
    transition: transform 0.2s ease;
}

.vote-left:active .vote-icon,
.vote-right:active .vote-icon {
    transform: scale(1.1);
}

.vote-count {
    font-size: 24rpx;
    font-weight: 600;
    text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.vote-left .vote-count {
    color: #ff4757;
}

.vote-right .vote-count {
    color: #2ed573;
}

/* 帖子内容区域 */
.post-content {
    flex: 1;
    padding: 0 12rpx;
    overflow: hidden;
}

/* 帖子头部信息 - 美化样式 */
.post-header {
    display: flex;
    align-items: center;
    margin-bottom: 24rpx;
    padding-bottom: 16rpx;
    border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.post-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    margin-right: 24rpx;
    flex-shrink: 0;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
    border: 3rpx solid rgba(255, 255, 255, 0.8);
    transition: transform 0.2s ease;
}

.post-avatar:active {
    transform: scale(0.95);
}

.post-user-info {
    flex: 1;
    overflow: hidden;
    margin-left: 18rpx;
}

.post-nickname {
    display: block;
    font-size: 34rpx;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 6rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0.5rpx;
}

.post-meta {
    display: flex;
    align-items: center;
}

.post-time {
    font-size: 26rpx;
    color: #7f8c8d;
    margin-right: 24rpx;
    font-weight: 500;
}

.location-icon {
    width: 28rpx;
    height: 28rpx;
    margin-right: 8rpx;
    opacity: 0.7;
}

.post-location {
    font-size: 26rpx;
    color: #7f8c8d;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 220rpx;
    font-weight: 500;
}

/* 帖子正文 - 美化样式 */
.post-body {
    margin-bottom: 28rpx;
}

.post-text {
    font-size: 32rpx;
    color: #34495e;
    line-height: 1.7;
    word-break: break-word;
    font-weight: 400;
    letter-spacing: 0.3rpx;
}

/* 帖子图片 - 美化样式 */
.post-images {
    display: flex;
    flex-wrap: wrap;
    margin-top: 24rpx;
    gap: 12rpx;
}

.post-image {
    width: 220rpx;
    height: 220rpx;
    border-radius: 12rpx;
    object-fit: cover;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.post-image:active {
    transform: scale(0.95);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

/* 打赏区域 - 重新布局：包含投票按钮 */
.reward-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 24rpx;
    border-top: 2rpx solid rgba(0, 0, 0, 0.06);
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.05) 0%, rgba(255, 193, 7, 0.02) 100%);
    border-radius: 12rpx;
    padding: 24rpx 12rpx;
    margin: 0 -4rpx;
}

.reward-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
    border-radius: 50rpx;
    padding: 16rpx 32rpx;
    margin-right: 24rpx;
    font-size: 30rpx;
    color: #333;
    font-weight: 600;
    border: none;
    box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.3);
    transition: all 0.3s ease;
}

.reward-btn:active {
    transform: scale(0.95);
    box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.4);
}

.reward-btn::after {
    border: none;
}

.reward-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 12rpx;
}

/* 加载更多提示 */
.load-more {
    text-align: center;
    padding: 30rpx;
    font-size: 28rpx;
    color: #999;
}

/* 底部导航栏 */
.tab-bar {
    display: flex;
    height: 100rpx;
    background-color: white;
    border-top: 2rpx solid #f0f0f0;
    padding-bottom: env(safe-area-inset-bottom);
    flex-shrink: 0;
}

.tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10rpx 0;
}

.tab-item.active .tab-text {
    color: #1989fa;
}

.tab-icon {
    width: 48rpx;
    height: 48rpx;
    margin-bottom: 8rpx;
}

.tab-text {
    font-size: 24rpx;
    color: #666;
}

/* 右下角悬浮按钮组 */
.float-buttons-container {
    position: fixed;
    bottom: 120rpx;
    right: 40rpx;
    display: flex;
    flex-direction: column;
    gap: 30rpx;
    z-index: 99;
}

/* 排序浮动按钮 */
.sort-float-btn {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #1989fa 0%, #0077e6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 30rpx rgba(25, 137, 250, 0.3);
    transition: all 0.3s ease;
}

.sort-icon {
    width: 48rpx;
    height: 48rpx;
}

/* 发帖按钮 */
.add-post-btn {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #44d2eb 0%, #7e9965 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 30rpx rgba(88, 104, 133, 0.3);
    transition: all 0.3s ease;
    border: none;
    color: white;
    font-size: 48rpx;
}

.add-post-btn::after {
    border: none;
}

/* 排序选项菜单 */
.sort-menu {
    position: fixed;
    bottom: 260rpx;
    right: 30rpx;
    background-color: white;
    border-radius: 16rpx;
    box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.12);
    overflow: hidden;
    z-index: 100;
    animation: fadeInUp 0.3s ease;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.sort-option {
    display: flex;
    align-items: center;
    padding: 30rpx 40rpx;
    border-bottom: 2rpx solid #f0f0f0;
    min-width: 240rpx;
}

.sort-option:last-child {
    border-bottom: none;
}

.sort-option-icon {
    width: 36rpx;
    height: 36rpx;
    margin-right: 20rpx;
}

.sort-option-text {
    flex: 1;
    font-size: 30rpx;
    color: #333;
}

.sort-check {
    width: 36rpx;
    height: 36rpx;
}

/* 打赏弹窗 */
.reward-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.reward-modal .modal-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
}

.reward-content {
    position: relative;
    width: 80%;
    background-color: white;
    border-radius: 20rpx;
    overflow: hidden;
    z-index: 1001;
}

.reward-content .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 40rpx 40rpx 20rpx;
}

.reward-content .modal-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
}

.reward-content .modal-close {
    font-size: 50rpx;
    color: #999;
    line-height: 1;
}

.reward-content .modal-body {
    padding: 0 40rpx 30rpx;
}

.reward-desc {
    display: block;
    font-size: 28rpx;
    color: #666;
    text-align: center;
    margin-bottom: 40rpx;
}

.reward-options {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 30rpx;
}

.reward-option {
    width: 45%;
    padding: 30rpx 0;
    background-color: #f8f8f8;
    border-radius: 16rpx;
    text-align: center;
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
    margin-bottom: 20rpx;
    border: 2rpx solid transparent;
}

.reward-option.selected {
    background-color: #e8f4ff;
    border-color: #1989fa;
    color: #1989fa;
}

.custom-reward {
    width: 100%;
    border: 2rpx solid #e6e6e6;
    border-radius: 16rpx;
    padding: 28rpx 30rpx;
    font-size: 30rpx;
    color: #333;
    text-align: center;
}

.reward-content .modal-footer {
    display: flex;
    border-top: 2rpx solid #f5f5f5;
}

.reward-content .modal-btn {
    flex: 1;
    border-radius: 0;
    border: none;
    font-size: 32rpx;
    height: 100rpx;
    line-height: 100rpx;
    background-color: transparent;
}

.reward-content .modal-btn::after {
    border: none;
}

.reward-content .modal-btn.cancel {
    color: #666;
    border-right: 2rpx solid #f5f5f5;
}

.reward-content .modal-btn.confirm {
    color: #1989fa;
}

/* 发帖悬浮按钮 */
.create-post-btn {
    position: fixed;
    bottom: 180rpx; /* 放在排序按钮上方 */
    right: 30rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 998;
    animation: floatUp 0.5s ease-out;
  }

  @keyframes floatUp {
    from {
      opacity: 0;
      transform: translateY(30rpx) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .create-post-btn-inner {
    width: 100rpx;
    height: 100rpx;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10rpx 30rpx rgba(240, 147, 251, 0.4);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .create-post-btn-inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.1);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .btn-hover .create-post-btn-inner::before {
    opacity: 1;
  }

  .create-post-btn:active .create-post-btn-inner {
    transform: scale(0.92);
    box-shadow: 0 5rpx 20rpx rgba(240, 147, 251, 0.3);
  }

