<!-- 使用 ColorUI 样式 -->
<view class="cu-bar bg-white solid-bottom">
  <view class="action">
    <text class="cuIcon-title text-blue"></text>
    <text>发布新内容</text>
  </view>
</view>

<form bindsubmit="formSubmit" bindreset="formReset">
  <!-- 标题输入 -->
  <view class="cu-form-group margin-top">
    <view class="title">标题</view>
    <input 
      placeholder="请输入标题（必填）" 
      name="title" 
      maxlength="50"
      value="{{title}}"
      bindinput="onTitleInput"
    />
    <text class="cuIcon-edit text-gray"></text>
  </view>

  <!-- 内容输入 -->
  <view class="cu-form-group align-start">
    <view class="title">内容</view>
    <textarea 
      placeholder="分享你的想法..." 
      name="content" 
      maxlength="500"
      value="{{content}}"
      bindinput="onContentInput"
      auto-height
    />
  </view>

  <!-- 图片上传 -->
  <view class="cu-bar bg-white margin-top">
    <view class="action">
      图片上传（{{imageList.length}}/3）
    </view>
    <view class="action">
      {{imageList.length}}/3
    </view>
  </view>
  
  <view class="cu-form-group">
    <view class="grid col-4 grid-square flex-sub">
      <view 
        class="bg-img" 
        wx:for="{{imageList}}" 
        wx:key="index"
        data-index="{{index}}"
        bindtap="ViewImage"
      >
        <image src="{{item}}" mode="aspectFill"></image>
        <view class="cu-tag bg-red" catchtap="DelImg" data-index="{{index}}">
          <text class="cuIcon-close"></text>
        </view>
      </view>
      <view class="solids" bindtap="ChooseImage" wx:if="{{imageList.length<3}}">
        <text class="cuIcon-cameraadd"></text>
      </view>
    </view>
  </view>

  <!-- 分类选择 -->
  <view class="cu-form-group">
    <view class="title">分类</view>
    <picker 
      range="{{categoryList}}" 
      value="{{categoryIndex}}"
      bindchange="onCategoryChange"
    >
      <view class="picker">
        {{categoryList[categoryIndex] || '请选择分类'}}
      </view>
    </picker>
  </view>

  <!-- 匿名选项 -->
  <view class="cu-form-group">
    <view class="title">匿名发布</view>
    <switch 
      class="switch" 
      checked="{{isAnonymous}}"
      bindchange="onAnonymousChange"
      color="#0081ff"
    />
  </view>

  <!-- 操作按钮 -->
  <view class="padding flex flex-direction margin-top-lg">
    <button 
      class="cu-btn bg-gradual-blue shadow-blur round lg" 
      form-type="submit"
      disabled="{{!title || !content}}"
      loading="{{isSubmitting}}"
    >
      {{isSubmitting ? '发布中...' : '立即发布'}}
    </button>
    
    <button 
      class="cu-btn line-blue margin-tb-sm round lg" 
      form-type="reset"
      bindtap="onCancel"
    >
      取消
    </button>
  </view>
</form>

<!-- 提示消息 -->
<view wx:if="{{showMessage}}" class="cu-modal {{showMessage ? 'show' : ''}}">
  <view class="cu-dialog">
    <view class="cu-bar bg-white justify-end">
      <view class="content">提示</view>
      <view class="action" bindtap="hideMessage">
        <text class="cuIcon-close text-red"></text>
      </view>
    </view>
    <view class="padding-xl">
      {{message}}
    </view>
    <view class="cu-bar bg-white">
      <view class="action margin-0 flex-sub text-green" bindtap="hideMessage">
        <text class="cuIcon-check"></text> 确定
      </view>
    </view>
  </view>
</view>