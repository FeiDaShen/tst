@import "../../colorui/main.wxss";

.mine-container {
  padding: 24px;
  background: #ffffff;
  min-height: 100vh;
}
.profile-card {
  display: flex;
  align-items: center;
  padding: 18px 12px;
  border-bottom: 1px solid #f0f0f0;
}
.profile-info {
  margin-left: 12px;
  flex: 1;
}
.nick {
  font-size: 18px;
  color: #333333;
  display: block;
  margin-bottom: 8px;
}
.stats {
  display: flex;
}
.stat {
  margin-right: 18px;
}
.num {
  font-weight: 600;
  display: block;
}
.label {
  color: #888888;
  font-size: 12px;
}
.menu-list {
  margin-top: 12px;
}
.menu-item {
  padding: 14px 12px;
  border-bottom: 1px solid #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.menu-item.logout {
  color: var(--red);
}
.section {
  padding: 12px;
}
.section-title {
  font-weight: 600;
  margin-bottom: 10px;
}
.post-item, .history-item, .fav-item {
  padding: 10px 0;
  border-bottom: 1px solid #f5f5f5;
}
.empty {
  color: #999;
  padding: 12px 0;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
}
.feedback-modal {
  position: fixed;
  left: 6%;
  right: 6%;
  top: 30%;
  background: #fff;
  border-radius: 8px;
  padding: 12px;
}
.feedback-header {
  font-weight: 600;
  font-size: 28px;
  margin-bottom: 8px;
}
.feedback-input {
  height: 140px;
  border: 1px solid #f0f0f0;
  padding: 8px;
  margin-bottom: 10px;
}
.feedback-actions {
  display: flex;
  justify-content: space-between;
}

/* card styles (use ColorUI .cu-card/.cu-item; keep small overrides) */
.cards {
  display: flex;
  flex-direction: row; /* 横向展示 */
  gap: 12px;
  margin-top: 12px;
  overflow-x: auto; /* 小屏幕横向滚动 */
  -webkit-overflow-scrolling: touch;
}

.cards > .cu-card {
  flex: 0 0 32%; /* 三列均分 */
  box-sizing: border-box;
}

/* 当屏幕太窄时降为两列或单列（可根据需要调整断点） */
@media screen and (max-width: 360px) {
  .cards > .cu-card { flex: 0 0 80%; }
}
@media screen and (min-width: 361px) and (max-width: 640px) {
  .cards > .cu-card { flex: 0 0 48%; }
}
.item-nick { font-size: 12px; color: #888; }
.item-time { font-size: 12px; color: #aaa; margin-left: 8px; }
.item-title { display: block; margin-top: 4px; font-weight: 500; }
.more { color: var(--blue); font-size: 12px; }

/* tabs */
.tab-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12px;
  background: #fff;
  padding: 6px;
  border-radius: 8px;
}
.tab-btn {
  flex: 1;
  text-align: center;
  padding: 10px 6px;
  color: #666;
  border-radius: 6px;
}
.tab-btn.active {
  background: var(--blue);
  color: #fff;
}
.display-area {
  margin-top: 12px;
  background: #fff;
  padding: 12px;
  border-radius: 8px;
}

.actions-column {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
}

.list-item.more {
  text-align: center;
  color: var(--blue);
  font-weight: 600;
}
.list-item { padding: 8px 6px; border-bottom: 1rpx solid #eee; }
.list-item:last-child { border-bottom: none; }
.item-title { display: block; margin-top: 4px; font-weight: 500; color: #333 }
.list-item:last-child { border-bottom: none; }
.meta-line { margin-top: 6px; display:flex; justify-content:space-between; color:#999; font-size:12px }
.more-btn { margin-top: 10px; display:block; width:100%; }

/* list modal */
.list-modal {
  position: fixed;
  left: 6%;
  right: 6%;
  top: 18%;
  bottom: 12%;
  background: #fff;
  border-radius: 8px;
  overflow: hidden;
}
.list-modal-header { padding: 12px; font-weight: 600; border-bottom: 1px solid #f5f5f5; }
.list-modal-body { padding: 10px; }
.list-row { padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
.list-row { padding: 8px 6px; border-bottom: 1rpx solid #eee; }
.row-nick { font-size: 12px; color: #666; }
.row-time { float: right; color: #aaa; font-size: 12px; }
.row-title { display: block; margin-top: 6px; font-weight: 500; color: #333; }
.list-modal-footer { padding: 10px; border-top: 1px solid #f5f5f5; text-align: right; }


